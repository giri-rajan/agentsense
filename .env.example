# ──────────────────────────────────────────────────────────────
# AgentSense — environment configuration
# Copy this file to `.env` and fill in your own Azure credentials.
# The app runs fully in MOCK MODE if these are left as placeholders,
# so you can demo it end-to-end without any cloud resources.
# ──────────────────────────────────────────────────────────────

# Azure OpenAI (core reasoning engine)
AZURE_OPENAI_API_KEY=your_azure_openai_key
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-08-01-preview
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# Azure Cosmos DB (session & blueprint persistence)
COSMOS_DB_ENDPOINT=https://your-account.documents.azure.com:443/
COSMOS_DB_KEY=your_cosmos_key
COSMOS_DB_DATABASE_NAME=agentsense_db

# Azure AI Search (RAG pattern-library retrieval)
AZURE_SEARCH_ENDPOINT=https://your-search.search.windows.net
AZURE_SEARCH_KEY=your_search_key
AZURE_SEARCH_INDEX_NAME=patterns-index

# Optional: Entra ID auth (not required for the demo)
AZURE_CLIENT_ID=your_client_id
AZURE_TENANT_ID=your_tenant_id
AZURE_CLIENT_SECRET=your_client_secret

# Application
ENVIRONMENT=development
PORT=8000
DEBUG=True
